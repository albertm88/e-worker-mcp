{
  "safety": {
    "mode": "whitelist",
    "auto_approve": [
      "todo.*",
      "time.*",
      "report.*",
      "meeting.*"
    ],
    "allow_rules": [
      "todo.*",
      "meeting.*",
      "time.*",
      "report.*"
    ],
    "deny_rules": [
      "file.delete",
      "env.modify"
    ]
  },
  "file": {
    "trash_dir": ".trash"
  }
}
